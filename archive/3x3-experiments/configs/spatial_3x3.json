{
  "name": "spatial_3x3_test",
  "dataset": "eyespot_training_3x3.txt",
  "feature_type": "Spatial",
  "architecture": {
    "hidden_layers": [128, 64],
    "activation": "relu",
    "dropout": null,
    "layer_norm": false
  },
  "training": {
    "learning_rate": 0.005,
    "steps": 20000,
    "batch_size": 1,
    "weight_decay": 0.01,
    "patience": 2000,
    "eval_frequency": 500
  },
  "output": {
    "save_dir": "experiments/spatial_3x3_test",
    "save_frequency": 2000,
    "verbose": true,
    "plots": false
  }
}
